<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/dialog_content_padding">

    <TextView
        android:id="@+id/dialog_tv_ussd_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:text="@string/ussd_code"
        android:labelFor="@+id/dialog_et_ussd_query"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <!--
        The dialpad (inputType=phone) of some keyboards, e.g. Gboard, has no key that types * or #, so the
        "*" and "#" buttons below insert them at the caret independently of the keyboard.
    -->
    <EditText
        android:id="@+id/dialog_et_ussd_query"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_et_margin_top"
        android:inputType="phone"
        android:importantForAutofill="no"
        app:layout_constraintTop_toBottomOf="@id/dialog_tv_ussd_code"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/dialog_b_star"
        />

    <Button
        android:id="@+id/dialog_b_star"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="48dp"
        android:text="@string/ussd_key_star"
        android:contentDescription="@string/ussd_key_star_description"
        app:layout_constraintTop_toTopOf="@id/dialog_et_ussd_query"
        app:layout_constraintBottom_toBottomOf="@id/dialog_et_ussd_query"
        app:layout_constraintStart_toEndOf="@id/dialog_et_ussd_query"
        app:layout_constraintEnd_toStartOf="@id/dialog_b_hash"
        />

    <Button
        android:id="@+id/dialog_b_hash"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="48dp"
        android:text="@string/ussd_key_hash"
        android:contentDescription="@string/ussd_key_hash_description"
        app:layout_constraintTop_toTopOf="@id/dialog_et_ussd_query"
        app:layout_constraintBottom_toBottomOf="@id/dialog_et_ussd_query"
        app:layout_constraintStart_toEndOf="@id/dialog_b_star"
        app:layout_constraintEnd_toEndOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>